/* light.qss - Stylesheet used for the light mode.*/

QMenu {
    color: #FFFFFF;
    border-radius: 4px;
    padding: 8px;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 8px;
}

QMenu::Item {
    background-color: transparent;
    padding: 7px 12px;
    font-size: 16px;
    font-family: "Segoe UI", Arial, sans-serif;
    border-radius: 6px;
    margin: 4px 0px;
}

QMenu::Item:selected {
    background-color: #c5c5c5;
}

QMenu::Separator {
    height: 1px;
    background: #c5c5c5;
    margin: 2px 4px;
}

QToolButton {
    background-color: #f8fafc;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 10px;
}

QToolButton:checked {
    background-color: #EAB308;
    color: #000000;
    border: none;
    border-radius: 6px;
    padding: 11px;
}

QToolButton#ItalicFormatButton {
    font-style: italic;
}

QToolButton#UnderlineFormatButton {
    text-decoration: underline;
}

QToolButton#BoldFormatButton {
    font-weight: bold;
}

QToolBar {
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 10px;
}

QPushButton#SideNavButton {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 30px;
}

QFrame#Header {
    background-color: #EAB308;
    border-bottom: 2px solid #0f172a;
}

QFrame#HeaderTitle {
    background: transparent;
    color: #0f172a;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: bold;
    font-size: 24px;
}

QFrame#Topic {
    border-bottom: 2px solid #0f172a;
}

QWidget#PostTitle {
    background: transparent;
    color: #0f172a;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: normal;
    font-size: 18px;
}

QWidget#TopicTitle {
    background: transparent;
    color: #0f172a;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: bold;
    font-size: 28px;
}

QFrame#Sidebar {
    background-color: #ffffff;
    border-right: 3px solid #EAB308;
}

QFrame#TopBar {
    border-bottom: 2px solid #EAB308;
    background: transparent;
}

QWidget {
    background-color: #ffffff;
    color: #0f172a;
    font-family: "Segoe UI", Arial, sans-serif;
}

QLabel#TitleLabel {
    font-size: 40px;
    font-weight: bold;
    color: #EAB308;
    background: transparent;
}

QLabel#TitleLabelCenter {
    font-size: 40px;
    font-weight: bold;
    color: #EAB308;
    background: transparent;
    qproperty-alignment: AlignCenter;
}

QLabel#HeadingLabel {
    font-size: 28px;
    font-weight: bold;
    color: #000000;
    background: transparent;
}

QLabel#SubheadingLabel {
    font-size: 14px;
    color: #64748b;
    background: transparent;
}

QLineEdit, QTextEdit {
    background-color: #f8fafc;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
}

QLineEdit:focus, QTextEdit:focus {
    border: 2px solid #EAB308;
}

QPushButton#LoginButton {
    background-color: #EAB308;
    color: #000000;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-radius: 6px;
    padding: 11px;
}

QPushButton#LoginButton:hover {
    background-color: #CA8A04;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #EAB308;
    border: 1px solid #EAB308;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#NavButton:hover {
    background-color: #EAB308;
    color: #000000;
}

QPushButton#ToggleButton {
    background-color: #f1f5f9;
    color: #334155;
    border: 2px solid #9a9a9a;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
    border-width: 1px;
}

QLabel#ErrorLabel {
    color: #b00020;
}