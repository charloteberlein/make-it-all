/* dark.qss - Stylesheet used for the dark mode.*/

QPushButton#SideNavButton {
    background-color: transparent;
    color: #0f172a;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 30px;
}

QFrame#Sidebar {
    background-color: #121820;
    border-right: 3px solid #EAB308;
}

QFrame#TopBar {
    border-bottom: 2px solid #EAB308;
    background: transparent;
}

QWidget {
    background-color: #121820;
    color: #e2e8f0;
    font-family: "Segoe UI", Arial, sans-serif;
}

QLabel#TitleLabel {
    font-size: 40px;
    font-weight: bold;
    color: #EAB308;
    background: transparent;
}

QLabel#TitleLabelCenter {
    font-size: 40px;
    font-weight: bold;
    color: #EAB308;
    background: transparent;
    qproperty-alignment: AlignCenter;
}

QLabel#HeadingLabel {
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
    background: transparent;
}

QLabel#SubheadingLabel {
    font-size: 14px;
    color: #94a3b8;
    background: transparent;
}

QLineEdit {
    background-color: #1e293b;
    color: #ffffff;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 2px solid #EAB308;
}

QPushButton#LoginButton {
    background-color: #EAB308;
    color: #000000;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-radius: 6px;
    padding: 11px;
}

QPushButton#LoginButton:hover {
    background-color: #CA8A04;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #EAB308
    border: 1px solid #EAB308;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#NavButton:hover {
    background-color: #EAB308;
    color: #000000;
}

QPushButton#ToggleButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 2px solid #334155;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
}