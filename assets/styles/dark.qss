/* dark.qss - Stylesheet used for the dark mode.*/

QPushButton#ToDoButton {
    background-color: #EAB308;
    color: #000000;
    font-weight: bold;
    font-size: 16px;
    border: none;
    border-radius: 6px;
    padding: 14px;
}

QPushButton#ToDoButton:hover {
    background-color: #CA8A04;
}

QTableWidget {
    font-size: 8pt;
    border: 2px solid #c7c7c7;
    gridline-color: #c7c7c7;
}

QComboBox#TableStatusCombo {
    padding: 2px 6px;
    font-size: 8pt;
}

QHeaderView::section {
    font-size: 10pt;
    font-weight: bold;
    background-color: #CA8A04;
    padding: 1px;
    border: 1px solid #c7c7c7;
}
   
QWidget {
    background-color: #121820;
    color: #e2e8f0;
    font-family: "Segoe UI", Arial, sans-serif;
    border: none;
}

QMenu {
    color: #e2e8f0;
    border-radius: 4px;
    padding: 8px;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 8px;
}

QMenu::Item {
    background-color: transparent;
    padding: 7px 12px;
    font-size: 16px;
    font-family: "Segoe UI", Arial, sans-serif;
    border-radius: 6px;
    margin: 4px 0px;
}

QMenu::Item:selected {
    background-color: #5b5b5b;
}

QMenu::Separator {
    height: 1px;
    background: #5b5b5b;
    margin: 2px 4px;
}

QToolButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 10px;
}

QToolButton:checked {
    background-color: #EAB308;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 11px;
}

QToolButton#ItalicFormatButton {
    font-style: italic;
}

QToolButton#UnderlineFormatButton {
    text-decoration: underline;
}

QToolButton#BoldFormatButton {
    font-weight: bold;
}

QToolBar {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 10px;
}

QPushButton#SideNavButton {
    background-color: transparent;
    color: #0f172a;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 30px;
}

QFrame#Header {
    background-color: #121820;
    border-bottom: 2px solid #EAB308;
}

QFrame#HeaderTitle {
    background: transparent;
    color: #EAB308;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: bold;
    font-size: 24px;
}

QWidget#PostTitle {
    background: transparent;
    color: #EAB308;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: normal;
    font-size: 18px;
}

QWidget#TopicTitle {
    background: transparent;
    color: #EAB308;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: bold;
    font-size: 28px;
}

QFrame#Sidebar {
    background-color: #121820;
    border-right: 3px solid #EAB308;
}

QFrame#TopBar {
    border-bottom: 2px solid #EAB308;
    background: transparent;
}

QFrame#Topic {
    border-bottom: 2px solid #e2e8f0;
}

QLabel#TitleLabel {
    font-size: 40px;
    font-weight: bold;
    color: #EAB308;
    background: transparent;
}

QLabel#TitleLabelCenter {
    font-size: 40px;
    font-weight: bold;
    color: #EAB308;
    background: transparent;
    qproperty-alignment: AlignCenter;
}

QLabel#HeadingLabel {
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
    background: transparent;
}

QLabel#SubheadingLabel {
    font-size: 14px;
    color: #94a3b8;
    background: transparent;
}

QLineEdit, QTextEdit, QComboBox {
    background-color: #1e293b;
    color: #ffffff;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 10px;
    font-size: 12pt;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:on {
    border: 2px solid #EAB308;
}

QPushButton#LoginButton {
    background-color: #EAB308;
    color: #000000;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-radius: 6px;
    padding: 11px;
}

QPushButton#LoginButton:hover {
    background-color: #CA8A04;
}

QPushButton#LoginButton:disabled {
    background-color: #334155;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #EAB308;
    border: 1px solid #EAB308;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#NavButton:hover {
    background-color: #EAB308;
    color: #000000;
}

QPushButton#PinkNavButton {
    background-color: transparent;
    color: #e7597a;
    border: 1px solid #e82d58;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#PinkNavButton:hover {
    background-color: #e82d58;
    color: #000000;
}

QPushButton#ToggleButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 2px solid #334155;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#ToggleButton:hover {
    background-color: #727a87;
    color: #000000;
}

QLabel#ErrorLabel {
    color: #cf6679;
}