/* dark.qss - Stylesheet used for the dark mode.*/

QScrollArea {
    border: none;
}

QScrollBar:vertical {
    background: #e2e8f0;
    width: 12px;
    border: none;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #94a3b8;
    min-height: 30px;
    border-radius: 6px;
}

ScrollBar::handle:vertical:hover {
    background: #64748b;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QLabel#ProgressTrackerHeader {
    background: transparent;
    color: #ffffff;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: bold;
    font-size: 24px;
}

QLabel#noProjectLabel {
    font-size: 16px;
    color: #ffffff;
    font-style: italic;
    background: transparent;
}

QFrame#ProgressFrame {
    background-color: transparent;
    border-radius: 8px;
}


 QProgressBar::chunk {
    background-color: #EAB308;
    border-radius: 4px;
}

QProgressBar {
    border: 2px solid #ffffff;
    border-radius: 8px;
    background-color: transparent;
    color: #2c3e50;
    text-align: center;
}

QToolButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 10px;
}

QToolButton:checked {
    background-color: #EAB308;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 11px;
}

QToolButton#ItalicFormatButton {
    font-style: italic;
}

QToolButton#UnderlineFormatButton {
    text-decoration: underline;
}

QToolButton#BoldFormatButton {
    font-weight: bold;
}

QToolBar {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 10px;
}

QPushButton#SideNavButton {
    background-color: transparent;
    color: #0f172a;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 30px;
}

QFrame#Header {
    background-color: #121820;
    border-bottom: 2px solid #EAB308;
}

QFrame#HeaderTitle {
    background: transparent;
    color: #EAB308;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: bold;
    font-size: 24px;
}

QWidget#PostTitle {
    background: transparent;
    color: #EAB308;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: normal;
    font-size: 18px;
}

QWidget#TopicTitle {
    background: transparent;
    color: #EAB308;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: bold;
    font-size: 28px;
}

QFrame#Sidebar {
    background-color: #121820;
    border-right: 3px solid #EAB308;
}

QFrame#TopBar {
    border-bottom: 2px solid #EAB308;
    background: transparent;
}

QFrame#Topic {
    border-bottom: 2px solid #e2e8f0;
}

QWidget {
    background-color: #121820;
    color: #e2e8f0;
    font-family: "Segoe UI", Arial, sans-serif;
}

QLabel#TitleLabel {
    font-size: 40px;
    font-weight: bold;
    color: #EAB308;
    background: transparent;
}

QLabel#TitleLabelCenter {
    font-size: 40px;
    font-weight: bold;
    color: #EAB308;
    background: transparent;
    qproperty-alignment: AlignCenter;
}

QLabel#HeadingLabel {
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
    background: transparent;
}

QLabel#SubheadingLabel {
    font-size: 14px;
    color: #94a3b8;
    background: transparent;
}

QLineEdit, QTextEdit {
    background-color: #1e293b;
    color: #ffffff;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
}

QLineEdit:focus, QTextEdit:focus {
    border: 2px solid #EAB308;
}

QPushButton#LoginButton {
    background-color: #EAB308;
    color: #000000;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-radius: 6px;
    padding: 11px;
}

QPushButton#LoginButton:hover {
    background-color: #CA8A04;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #EAB308;
    border: 1px solid #EAB308;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#NavButton:hover {
    background-color: #EAB308;
    color: #000000;
}

QPushButton#ToggleButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 2px solid #334155;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
}

QLabel#ErrorLabel {
    color: #cf6679;
}